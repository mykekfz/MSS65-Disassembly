/* Technical notes - V912 definitions.
   Calibration addresses aligned against the V912 image (0pa/0da) by table structure, code read-width
   evidence and value comparison with V452 (05.11.2026). Ignition calibration layout is identical to V452.
   Characteristics that could not be placed with confidence are left out, including most of the
   generator / power-management / IBS block (rewritten in V912).
   Descriptions ending in [V912: differs from V452 160E] hold a different value than the V452 160E data set.
   RAM measurements are not included: the V912 RAM layout differs from V452 and has not been re-mapped. */
/begin PROJECT MSS65-ign-V912 "MSS65 IGN - V912.00-B204.00, data set 0569Q60Z520E"

/begin HEADER ""
  VERSION    "V912.00-B204.00"
/end HEADER

/begin MODULE  _MSS65-ign "MSS65 IGN - V912.00-B204.00, data 7842800"
/*----------------------------------------------------------------------------------------*/
    /begin MOD_COMMON  ""
      BYTE_ORDER MSB_FIRST                          /* Default byteorder (Motorola)            */
    /end MOD_COMMON
/*----------------------------------------------------------------------------------------*/


