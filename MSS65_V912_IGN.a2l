  /begin MOD_PAR 
   "" 
   VERSION 		"ccp 2.1"  
   ADDR_EPK 	0x00070289 
   EPK 			"V912"  
   SUPPLIER 	""  
   CUSTOMER 	""  
   CUSTOMER_NO 	""  
   USER 		""  
   ECU 			"MSS65-IGN"


      /* Description of memory-segments. There has to be a CODE and DATA-Segment to         */
      /* support the generation of valid flashable HEX-Files                                */
      /*----------------------------------------------------------------------------------------*/

      /begin MEMORY_SEGMENT                         /* The new keyword MEMORY_SEGMENT is    */
                                                    /* is used to replace the keyword       */
                                                    /* MEMORY_LAYOUT with ASAP2 Version 1.3 */
        CODESEG1 "Program"                 			/* Name, Longidentifier                 */
        CODE                                        /* Programmtype                         */
        FLASH                                       /* Memorytype                           */
        INTERN                                      /* Attributes of Memorysegment          */
        0x10000 0x60000                             /* Address, Size                        */
        -1 -1 -1 -1 -1                              /* Offset address of mirrored segments  */
                                                    /* here default values                  */

      /end MEMORY_SEGMENT

      /begin MEMORY_SEGMENT                         /* The new keyword MEMORY_SEGMENT is    */
                                                    /* is used to replace the keyword       */
                                                    /* MEMORY_LAYOUT with ASAP2 Version 1.3 */
        CODESEG2 "Program"                 			/* Name, Longidentifier                 */
        CODE                                        /* Programmtype                         */
        FLASH                                       /* Memorytype                           */
        EXTERN                                      /* Attributes of Memorysegment          */
        0x450000 0x1B0000                           /* Address, Size                        */
        -1 -1 -1 -1 -1                              /* Offset address of mirrored segments  */
                                                    /* here default values                  */

      /end MEMORY_SEGMENT

      /*----------------------------------------------------------------------------------------*/
      
      /begin MEMORY_SEGMENT                         /* The new keyword MEMORY_SEGMENT is    */
                                                    /* is used to replace the keyword       */
                                                    /* MEMORY_LAYOUT with ASAP2 Version 1.3 */
        DATASEG1 "Appl.-DATA"                       /* Name, Longidentifier                 */
        DATA                                        /* Programmtype                         */
        FLASH                                       /* Memorytype; RAM wird nicht unterst�tzt */
        INTERN                                      /* Attributes of Memorysegment          */
        0x70000 0x10000                             /* Address, Size                        */
        -1 -1 -1 -1 -1                              /* Offset address of mirrored segments  */
                                                    /* here default values                  */

      /end MEMORY_SEGMENT

      /*----------------------------------------------------------------------------------------*/

	  /begin MEMORY_SEGMENT  			           	/* The new keyword MEMORY_SEGMENT  		*/
                                  					/* is used to replace the keyword 		*/
                                  					/* MEMORY_LAYOUT with ASAP2 Version 1.3 */
	    VARSEG "Variablen"              			/* Name, Longidentifier                 */
  		VARIABLES                       			/* Programmtype                         */
  		RAM                             			/* Memorytype                           */
  		INTERN                          			/* Attributes of Memorysegment          */
  		0x3F8000 0x8000                 			/* Address, Size                        */
  		-1 -1 -1 -1 -1                  			/* Offset address of mirrored segments  */
                                  					/* here default values                  */

	  /end MEMORY_SEGMENT

      /*----------------------------------------------------------------------------------------*/

      /begin CALIBRATION_METHOD
       "DSERAP"                                    /* Name of Method */
       1                                           /* Version No. */
       /begin CALIBRATION_HANDLE
        0x70000                                    /* Begin of Calibration-Data  */
        0xFFFC                                     /* Length of Calibration-Data */
       /end CALIBRATION_HANDLE
      /end CALIBRATION_METHOD

    /end MOD_PAR

/*----------------------------------------------------------------------------------------*/






/*----------------------------------------------------------------------------------------*/

    /begin IF_DATA ASAP1B_CCP                       /* spezific definition for CCP          */

      /*----------------------------------------------------------------------------------------*/

      /* -------------------------------- */
      /* schnelle zeitsynchrone DAQ-Liste */
      /* -------------------------------- */
      /begin SOURCE                                 /* Description of a DAQ                 */
                                                    /* (Data Acquisition List)              */
        "5 ms"                                      /* Name                                 */
        3                                           /* Basic Scale Unit: 3 -> 1ms           */
        5                                           /* Rate: 5 * 1ms = 5ms                  */

        /begin QP_BLOB                              /* The QP-BLOB specifies the behavior of*/
                                                    /* the corresponding DAQ-List           */

          0                                         /* Number of DAQ-list                   */
          LENGTH   20                               /* Number of ODT's, which can be in-    */
                                                    /* serted to this DAQ                   */
          CAN_ID_FIXED   0x410                      /* CAN-ID for measuring this DAQ        */
          RASTER   0                                /* ECU event-number according to event- */
                                                    /* number by the keyword RASTER.        */
                                                    /* Must be defined, but is not supported*/
                                                    /* by ETAS yet (aber by MCS)            */                 
          FIRST_PID  0                              /* Nummer des 1. ODT                    */

        /end QP_BLOB
      /end SOURCE

      /*----------------------------------------------------------------------------------------*/

      /* -------------------------------- */
      /* langsame zeitsynchrone DAQ-Liste */
      /* -------------------------------- */

      /begin SOURCE                                 /* Description of a DAQ                 */
                                                    /* (Data Acquisition List)              */
        "100 ms"                                    /* Name                                 */
        5                                           /* Basic Scale Unit: 5 -> 100ms         */
        1                                           /* Rate: 1 * 100ms = 100ms              */

        /begin QP_BLOB                              /* The QP-BLOB specifies the behavior of*/
                                                    /* the corresponding DAQ-List           */

          1                                         /* Number of DAQ-list                   */
          LENGTH   10                               /* Number of ODT's, which can be in-    */
                                                    /* serted to this DAQ                   */
          CAN_ID_FIXED   0x411                      /* CAN-ID for measuring this DAQ        */
          RASTER   1                                /* ECU event-number according to event- */
                                                    /* number by the keyword RASTER.        */
                                                    /* Must be defined, but is not supported*/
                                                    /* by ETAS yet (aber by MCS)            */                 
          FIRST_PID  20                             /* Nummer des 1. ODT                    */

        /end QP_BLOB
      /end SOURCE

      /*----------------------------------------------------------------------------------------*/

      /* ------------------------- */
      /* winkelsynchrone DAQ-Liste */
      /* ------------------------- */
      
      /begin SOURCE                                 /* Description of a DAQ                 */
                                                    /* (Data Acquisition List)              */
        "segment-synchron"                          /* Name                                 */
        103                                         /* Basic Scale Unit: 103 -> Segment     */
        1                                           /* Rate: 1 * Seg = Seg                  */

        /begin QP_BLOB                              /* The QP-BLOB specify the behavior of  */
                                                    /* the corresponding DAQ-List           */

          2                                         /* Number of DAQ-list                   */
          LENGTH   10                               /* Number of ODT's, which can be in-    */
                                                    /* serted to this DAQ                   */
          CAN_ID_FIXED   0x412                      /* CAN-ID for measuring this DAQ        */
          RASTER   2                                /* noch pruefen!!!! p_wax */
                                                    /* ECU event-number according to event- */
                                                    /* number by the keyword RASTER.        */
                                                    /* Must be defined, but is not supported*/
                                                    /* by ETAS yet (aber by MCS)            */                 
          FIRST_PID  30                             /* Nummer des 1. ODT                    */

        /end QP_BLOB
      /end SOURCE

      /*----------------------------------------------------------------------------------------*/

      /begin RASTER                                 /* ECU-event specification              */
        "5ms-Task"                                  /* Name of the ECU-event                */
        "5ms"                                       /* Shortname                            */
        0                                           /* Number of ECU-event                  */
        3                                           /* Scaling Unit: 3 = 1 msec             */
        5                                           /* Rate in Scaling Unit: 5              */
      /end RASTER

      /*----------------------------------------------------------------------------------------*/

      /begin RASTER                                 /* ECU-event specification              */
        "100ms-Task"                                /* Name of the ECU-event                */
        "100ms"                                     /* Shortname                            */
        1                                           /* Number of ECU-event                  */
        5                                           /* Scaling Unit: 5 = 100 msec           */
        1                                           /* Rate in Scaling Unit: 1              */
      /end RASTER

      /*----------------------------------------------------------------------------------------*/

      /begin RASTER                                 /* ECU-event specification              */
        "sync-Task"                                 /* Name of the ECU-event                */
        "sync"                                      /* Shortname                            */
        2                                           /* Number of ECU-event                  */
        103                                         /* Scaling Unit: 103 = cylinder segment */
        1                                           /* Rate in Scaling Unit: 1              */
      /end RASTER

      /*----------------------------------------------------------------------------------------*/

      /begin TP_BLOB                                /* This BLOB describes all parameters   */
                                                    /* that are necessary for CAN-timing and*/
                                                    /* ECU-calibration-technics             */
        0x0201                                      /* CCP-Version V2.1 => 0x0201           */
                                                    /*             V2.0 => 0x0200           */
        0x0202                                      /* BLOB-Version V2.2 => 0x0202          */
        0x400                                       /* CAN-ID  CCP -> ECU                   */
        0x401                                       /* CAN-ID  ECU -> CCP                   */      

        0x1234                                      /* ECU CCP-Address                      */      
        1                                           /* Byte-order: 1 - High-Byte-First (MOT)*/
                                                    /*             2 - Low-Byte-First(INTEL)*/

        /begin CAN_PARAM                            /* Interface CAN-Conrtoller settings    */
           0x01f4                                   /* CAN-Baudrate in kBd: 0x01F4 = 500 kBd*/
           0x41                                     /* Bittimingregister BTR0: 0x41         */
           0x25                                     /* Bittimingregister BTR1: 0x25         */
        /end CAN_PARAM

        BAUDRATE 500000                             /* Baud rate                            */
        SAMPLE_POINT 66                             /* Sampling Point of time in percent    */
        SAMPLE_RATE 1                               /* number of samples per bit            */
        STORE_SUPPORTED                             /* ECU supports the Store function      */
        RESUME_SUPPORTED                            /* ECU supports the Resume function     */

        /begin CHECKSUM_PARAM 			   
           0x8009                                   /* Auswahl Checksum-Funktionen          */                          
           0xFFFC                                   /* Max. Blocklaenge                     */
           CHECKSUM_CALCULATION ACTIVE_PAGE         /* akt. Seite berechnen                 */
        /end CHECKSUM_PARAM

        /begin DEFINED_PAGES                        /* Description of the memory-page       */
          1                                         /* Logical-page-number                  */
          "Workingpage"                             /* Name of page                         */
          0x0000                                    /* Address-Extension                    */
                                                    /* (only low-byte sgnificant)           */
          0xc70000                                  /* Address of Memorypage               */ 
          0x10000                                   /* Memorysize                           */
          RAM                                       /* Memorytype                           */ 
          FLASH_BACK                                /* feature available to flash back the RAM memory page */
          DEFAULT                                   /* Page is standard (fallback mode)     */
          RAM_INIT_BY_ECU                           /* Initialisationmethode: die ECU initialisiert die WP eigenstaendig  */
                                                    /* INCA vermeidet mit dieser Einstellung das Senden des MOVE-Commands */
                                                    /* beim CCP-Session-Login.                                            */
        /end DEFINED_PAGES                 

        /begin DEFINED_PAGES                        /* Description of the memory-page       */
          2                                         /* Logical-page-number                  */
          "Referenzpage"                            /* Name of page                         */
          0x0000                                    /* Address-Extension                    */
                                                    /* (only low-byte sgnificant)           */
          0x70000                                   /* Address of Memorypage                */ 
          0x10000                                   /* Memorysize                           */
          FLASH                                     /* Memorytype                           */ 
          RAM_INIT_BY_ECU                           /* Initialisationmethode: die ECU initialisiert die WP eigenstaendig  */
                                                    /* INCA vermeidet mit dieser Einstellung das Senden des MOVE-Commands */
                                                    /* beim CCP-Session-Login.                                            */
        /end DEFINED_PAGES                 

           OPTIONAL_CMD 0x0C                        /* GetSessionStatus                      */
           OPTIONAL_CMD 0x0D                        /* SetSessionStatus                      */
           OPTIONAL_CMD 0x0E                        /* BuildChecksum                         */
           OPTIONAL_CMD 0x09                        /* GetCalPage                            */
           OPTIONAL_CMD 0x10                        /* Clear Memory                          */
           OPTIONAL_CMD 0x11                        /* SelectCalPage                         */
           OPTIONAL_CMD 0x12                        /* GetSeed                               */
           OPTIONAL_CMD 0x13                        /* Unlock                                */
           OPTIONAL_CMD 0x18                        /* Programm                              */
           OPTIONAL_CMD 0x19                        /* Move                                  */
           OPTIONAL_CMD 0x22                        /* Programm6                             */
           OPTIONAL_CMD 0x23                        /* Download6                             */

      /end TP_BLOB

    /end IF_DATA
    
/*----------------------------------------------------------------------------------------*/

/begin IF_DATA ASAP1B_KWP2000
  /begin SOURCE
    "timeslot" 0 0
    QP_BLOB 0 BLOCKMODE 0xf0 0 20
  /end SOURCE
  /begin TP_BLOB
    0x0100                          /* blob Version */
    0x11                            /* ECU address on k line */
    0xF1                            /* required tester address */
    WuP                             /* stimulation mode of ECU: WuP */
    MSB_FIRST                       /* byte order in measurements and characteristics */
    1                               /* 1: 1st startDiagnosticSession without baudrate switch */
    0x00000                         /* Project base address (PBA) */

/*SERAM SERAM_A SERAM_U SERAM_O SERAM_E Flash addr  RAM addr  Data rd  code ver  Code read  Load mode*/
    SERAM   0x60100 0x60100 0x6FAFF 0x6FAFF 0     0     1   0     0        1

    /begin CHECKSUM
      0x010201                      /* check sum type qualifier (see table) */
      1                             /* 1: check sum calculation only on active page */
      1                             /* No of local routine for check sum */
      RequestRoutineResults         /* result of checksum routine delivered by */
      RNC_RESULT 0x23               /* only at 'RequestRoutineResults': */
                                    /* result codes, that sign 'calculation in progress' */
    /end CHECKSUM

    /begin FLASH_COPY
      TOOLFLASHBACK       	        /* ECU mode for copying RAM into Flash */
      3                             /* No of local routine for copy Flash to RAM */
      RequestRoutineResults         /* result of copy routine delivered by */
      RAM_InitByECU                 /* ECU mode for copying Flash into RAM */
      0x86                          /* diagnostic mode for copy RAM to Flash */
      COPY_FRAME 1                  /* list of page frames to be copied */
      RNC_RESULT 0x23 0xfb 0xfc     /* only at 'RequestRoutineResults': */
                                    /* result codes, that sign 'copy in progress' */
      /* COPY_PARA */               /* list of add. parameters for local routine */
    /end FLASH_COPY

    /*Baudrate switch: BaudRate  DiagMode  i,k for ECU baudrate*/
    /*  BAUD_DEF           250000    0x86      0xA7 */
    /*  BAUD_DEF           125000    0x86      0x87 */
    /*  BAUD_DEF           111111    0x86      0x84 */
    /*  BAUD_DEF            55555    0x86      0x64 */
    /*  BAUD_DEF            10400    0x86      0x14 */

    /*Timing parameter:  p1Max  p2Min  p2Max  p3Min  p3Max  p4Min */
    /*Timing parameter:  p1Max  p2Min  p2Max  p3Min  p3Max  p4Min */
    /*  TIME_DEF           1      0     50      0    500      0 */
    /*  TIME_DEF           2      0     50      0    500      0 */
    /*  TIME_DEF           5      1    100      1    500      0 */
    /*  TIME_DEF          10      1    500      2   1000      1 */
      TIME_DEF              20      2   25      28   250      0
       



  /end TP_BLOB
/end IF_DATA

/*----------------------------------------------------------------------------------------*/



