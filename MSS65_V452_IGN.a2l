/begin CHARACTERISTIC K_N_GETR_HS_DIAG_ABTR_MIN
  "[V452-new, name assigned] Gearbox input speed diagnosis (fn 0x556D4): release only if n_getr_abtrieb >= this value"
  VALUE
  0x786A8
  TKW_VV_VV_SW
  12000.0
  FORMULA_0006
  -12000.0000
  12000.0000
  FORMAT "%5.0"
/end CHARACTERISTIC

/begin CHARACTERISTIC K_N_GETR_HS_DIAG_N_MAX
  "[V452-new, name assigned] Gearbox input speed diagnosis (fn 0x556D4): release only if engine speed n <= this value"
  VALUE
  0x786AA
  TKW_VV_VV_SW
  12000.0
  FORMULA_0006
  -12000.0000
  12000.0000
  FORMAT "%5.0"
/end CHARACTERISTIC


