/begin MEASUREMENT md_e2_fehler
  "Fehlerstatus Ebene 2"
  UBYTE
  FORMULA_0801
  0
  0
  0.0
  255.0
  /begin IF_DATA DIM 0x3FC7A6 INTERN LONG /end IF_DATA
  ECU_ADDRESS 0x3FC7A6
/end MEASUREMENT


