    FORMULA_0006
    18
    0.0
    10000.0000
  /end AXIS_DESCR
  /begin AXIS_DESCR
    STD_AXIS
    pumg
    FORMULA_0077
    3
    400.0000  
    1200.0000 
    FORMAT "%4.1"
  /end AXIS_DESCR
  FORMAT "%4.1"
/end CHARACTERISTIC


