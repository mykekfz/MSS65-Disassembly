/* TPU KW FORMELN ------------------------------------------------------------------------*/

/begin COMPU_METHOD FORMULA_KW1
  "FORMULA_KW1"
  RAT_FUNC
  "%5.0"
  "-"
  COEFFS  0 256 0 0 0 1 
/end COMPU_METHOD

/begin COMPU_METHOD FORMULA_KW3
  "FORMULA_KW3"
  TAB_VERB
  "%5.0"
  "-"
  COMPU_TAB_REF FORMULA_KW3_VTAB
/end COMPU_METHOD

/begin COMPU_VTAB FORMULA_KW3_VTAB
  "FORMULA_KW3_VTAB"
  TAB_VERB
  13
  0 "ini"
  1 "1st edge"
  2 "second edge"
  3 "wait teeth"
  4 "search gap"
  5 "1st missing required"
  6 "last tooth until gap"
  7 "1st missing tooth"
  8 "2nd missing tooth"
  9 "1st tooth after gap"
  10 "2nd tooth after gap"
  11 "tooth 2..56, 62..116"
  12 "gap required"
  DEFAULT_VALUE "1 undefined"
/end COMPU_VTAB

/begin COMPU_METHOD FORMULA_KW4
  "FORMULA_KW4"
  RAT_FUNC
  "%5.0"
  "-"
  COEFFS  0 1 0 0 0 1 
/end COMPU_METHOD

/begin COMPU_METHOD FORMULA_KW5
  "FORMULA_KW5"
  RAT_FUNC
  "%5.0"
  "Upm"
  COEFFS  0 0 27344 0 1 0 
/end COMPU_METHOD

/begin COMPU_METHOD FORMULA_KW6
  "FORMULA_KW6"
  RAT_FUNC
  "%6.4"
  "�"
  COEFFS  0 1 0 0 0 0.00004291534423828125 
/end COMPU_METHOD

/begin COMPU_METHOD FORMULA_KW8
  "FORMULA_KW8"
  RAT_FUNC
  "%9.2"
  "ms"
  COEFFS  0 7000 0 0 0 1 
/end COMPU_METHOD

/begin COMPU_METHOD FORMULA_KW9
  "FORMULA_KW9"
  RAT_FUNC
  "%7.2"
  "ms"
  COEFFS  0 1 0 0 0 2.34057 
/end COMPU_METHOD

/begin COMPU_METHOD FORMULA_KW10
  "FORMULA_KW10"
  RAT_FUNC
  "%7.2"
  "�"
  COEFFS  0 1 0 0 0 0.01098633 
/end COMPU_METHOD

/begin COMPU_METHOD FORMULA_KW11
  "FORMULA_KW11"
  RAT_FUNC
