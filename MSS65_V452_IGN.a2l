/* ------------------  Abschnitt erzeugt aus tpu_ign.dat ------------------ */
 

/begin CHARACTERISTIC K_TPU_IGN_MISS_FIRE_TIME
  "Ini Schliesszeit fuer die Ausgabe von Fehlzuendungen. | EN: Initial dwell time for output of misfires"
  VALUE
  0x79B3C
  TKW_VV_VV_UB
  100.0
  FORMULA_1027
  0.0
  291.4285  
/end CHARACTERISTIC


/begin CHARACTERISTIC K_TPU_IGN_MIN_SCI_POS
  "Ini minimalen Winkelabstand vorm Zuendwinkel. | EN: Initial minimum angle distance before ignition angle"
  VALUE
  0x79B3E
  TKW_VV_VV_SW
  100.0
  FORMULA_0710
  -360.0000 
  359.9000  
  FORMAT "%4.1"
/end CHARACTERISTIC



/* ------------------  Abschnitt erzeugt aus tsgrw.dat ------------------ */
 

/begin CHARACTERISTIC K_TSGRW_TU
  "Tuning Saugrohrwandtemperatur | EN: Tuning of intake-manifold wall temperature"
  VALUE
  0x79B44
  TKW_VV_VV_SW
  100.0
  FORMULA_1028
  -50.0000  
  170.0000  
  FORMAT "%4.1"
/end CHARACTERISTIC


/begin CHARACTERISTIC K_TSGRW_CFG
  "Schalter welches TSGRW | EN: Switch selecting intake-manifold wall temperature source"
  VALUE
  0x79B46
  TKW_VV_VV_UB
  100.0
  FORMULA_1029
  0.0
  255.0
  BIT_MASK 0x1
/end CHARACTERISTIC


/begin CHARACTERISTIC K_TSGRW_TAU
  "Filterkonstante fuer die Saugrohrwandtemperatur | EN: Filter constant for intake-manifold wall temperature"
  VALUE
  0x79B47
  TKW_VV_VV_UB
  100.0
  FORMULA_0679
  0.1004    
  25.6000   
  FORMAT "%5.2"
/end CHARACTERISTIC


/begin CHARACTERISTIC K_TSGRW_TAU_MS
  "Filterkonstante fuer die Saugrohrwandtemperatur bei stehendem Motor | EN: Filter constant for intake-manifold wall temperature with engine stopped"
  VALUE
  0x79B48
  TKW_VV_VV_UB
  100.0
  FORMULA_0679
  0.1004    
  25.6000   
  FORMAT "%5.2"
/end CHARACTERISTIC


/begin CHARACTERISTIC KL_TSGRW_OFFS
  "Kennlinie Offset | EN: Offset curve"
  CURVE
  0x79B4A
  TKL_SW_VV_SW
  100.0
  FORMULA_1030
  -800.0000 
  800.0000  
  /begin AXIS_DESCR
    STD_AXIS
    rf
    FORMULA_0007
    5
    0.0
    2.0000    
    FORMAT "%6.3"
  /end AXIS_DESCR
  FORMAT "%6.3"
/end CHARACTERISTIC


/begin CHARACTERISTIC KL_TSGRW_F
  "Verhaeltnisfaktor | EN: Ratio factor"
  CURVE
  0x79B60
  TKL_SW_VV_UW
  100.0
  FORMULA_0024
  0.0
  1.9999    
  /begin AXIS_DESCR
    STD_AXIS
    tmot
    FORMULA_0023
    4
    -50.0000  
    170.0000  
    FORMAT "%4.1"
  /end AXIS_DESCR
  FORMAT "%7.4"
/end CHARACTERISTIC


