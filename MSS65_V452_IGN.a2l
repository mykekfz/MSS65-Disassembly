/* Technical notes - V452 definitions.
   Calibration addresses remapped by structural + code alignment against the V452 full read (04.11.2026).
   Calibration layout: 0x786A8-0x786AB hold the V452-specific constants K_N_GETR_HS_DIAG_ABTR_MIN / _N_MAX.
   English text (EN:) taken from the MSS60 V762 definition where the name matches.
   RAM measurements: 98.7% of code-accessed addresses confirmed in V452; blocks marked "V452 CHECK" are not valid. */
/begin PROJECT MSS65-ign-V452 "MSS65 IGN - V452.01-B204.00, data set 0569Q60Z160E"

/begin HEADER ""
  VERSION    "V452.01-B204.00"
/end HEADER

/begin MODULE  _MSS65-ign "MSS65 IGN - V452.01-B204.00, calibration xxxxxxxx"
/*----------------------------------------------------------------------------------------*/
    /begin MOD_COMMON  ""
      BYTE_ORDER MSB_FIRST                          /* Default byteorder (Motorola)            */
    /end MOD_COMMON
/*----------------------------------------------------------------------------------------*/


/* Formel fuer 1:1-Wiedergabe ohne Einheit */

/begin COMPU_METHOD FORMULA_USER1
  "FORMULA_USER1"
  RAT_FUNC
  "%7.0"
  "-"
  COEFFS  0 1 0 0 0 1 
/end COMPU_METHOD

/begin MEASUREMENT sys_sypcr
  "Watchdog-Register"
  ULONG
  FORMULA_USER1
  0
  0
  0.0000
  4294967295.0000
  /begin IF_DATA DIM 0x2FC004 INTERN LONG /end IF_DATA
  ECU_ADDRESS 0x2FC004
  /begin FUNCTION_LIST Systemvariablen
  /end FUNCTION_LIST
/end MEASUREMENT

/*--------------------------- QADC A + B ------------------------------------------------*/

