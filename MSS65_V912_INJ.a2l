  /begin AXIS_DESCR
    STD_AXIS
    FORMULA_0023
    3
    -50.0000  
    170.0000  
    FORMAT "%4.1"
  /end AXIS_DESCR
/end CHARACTERISTIC


/begin CHARACTERISTIC KL_ZUST_MD_TL_VL
  "md_rel fuer Uebergang TL -> VL | EN: Relative torque for transition part load to full load | [Code V452] Torque-demand threshold for the part-load -> full-load state (zust_md_rel_tl_vl, also sent to IGN). Ignition blends from KF_TZ_GRUND to KF_TZ_VL between this value (90 %) and 100 % md_wunsch_rel (IGN 0x66284)."
  CURVE
  0x7A2AA
  TKL_SW_VV_SW
  100.0
  FORMULA_0001
  0.0
  100.0000  
  /begin AXIS_DESCR
    STD_AXIS
    FORMULA_0006
    6
    0.0
    10000.0000
  /end AXIS_DESCR
  FORMAT "%4.1"
/end CHARACTERISTIC





