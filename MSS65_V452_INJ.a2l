  TAB_VERB
  5
  0x04 "in rising edge"
  0x08 "in falling edge"
  0x0C "in both edges"
  0xE1 "out pin high"
  0xE2 "out pin low"
  DEFAULT_VALUE "1 undefined"
/end COMPU_VTAB

