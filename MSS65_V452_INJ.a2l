/begin CHARACTERISTIC K_AG_TI_CFG
  "Welcher Aussetzergenerator"
  VALUE
  0x70294
  TKW_VV_VV_UB
  100.0
  FORMULA_0581
  0.0
  3.0
/end CHARACTERISTIC


/begin CHARACTERISTIC K_AG_TI_ZYL
  "Statisches Ausblendmuster. | EN: Static suppression pattern"
  VALUE
  0x70296
  TKW_VV_VV_UW
  100.0
  FORMULA_0010
  0.0
  65535.0000
/end CHARACTERISTIC


/begin CHARACTERISTIC K_AG_TI_ANZ
  "Anzahl der unmittelbar aufeinanderfolgenden Ausblendungen. | EN: Number of directly consecutive suppressions (injection cut-outs)"
  VALUE
  0x70298
  TKW_VV_VV_UW
  100.0
  FORMULA_0010
  0.0
  65535.0000
/end CHARACTERISTIC


/begin CHARACTERISTIC K_AG_TI_PAUSE
  "Anzahl der Arbeitsspiele zwischen Ausblendungen. | EN: Number of working cycles between suppressions"
