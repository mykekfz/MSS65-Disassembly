  0x78154
  TKW_VV_VV_UB
  100.0
  FORMULA_1189
  0.0
  255.0
/end CHARACTERISTIC


/begin CHARACTERISTIC K_TKSM_MR_TAU
  "Filterkonstante fuer Motorraumtemperatur | EN: Filter constant for engine-bay temperature [s]"
  VALUE
  0x78156
  TKW_VV_VV_UW
  100.0
  FORMULA_1059
  0.1000    
  6553.5000 
  FORMAT "%5.2"
/end CHARACTERISTIC


/begin CHARACTERISTIC KL_TKSM_Q_MOT_TAU
  "Kraftstoffverbrauch zu tau | EN: Fuel consumption to time constant"
  CURVE
  0x78158
  TKL_SW_VV_UW
  100.0
  FORMULA_1059
  0.1000    
  6553.5000 
  /begin AXIS_DESCR
    STD_AXIS
    kva_q_mot
    FORMULA_0746
    6
    0.0
    256.0000  
    FORMAT "%4.1"
  /end AXIS_DESCR
  FORMAT "%5.2"
/end CHARACTERISTIC


/begin CHARACTERISTIC KL_TKSM_Q_MOT_RATIO
  "Faktor Kraftstoffverbrauch fuer TKSM-Modell | EN: Fuel consumption factor for fuel-temperature model"
  CURVE
  0x78172
  TKL_SW_VV_UW
  100.0
  FORMULA_0295
  0.0
  2.0000    
  /begin AXIS_DESCR
    STD_AXIS
    kva_q_mot
    FORMULA_0746
    6
    0.0
    256.0000  
    FORMAT "%4.1"
  /end AXIS_DESCR
  FORMAT "%7.4"
/end CHARACTERISTIC


/begin CHARACTERISTIC KL_TKSM_ABREG
  "Abregung ueber Zeit | EN: Ramp-down over time"
  CURVE
  0x7818C
  TKL_UW_VV_UW
  100.0
  FORMULA_0295
  0.0
  2.0000    
  /begin AXIS_DESCR
    STD_AXIS
    time_ms
    FORMULA_0600
    6
    0.0
    1092.2500 
    FORMAT "%5.2"
  /end AXIS_DESCR
  FORMAT "%7.4"
/end CHARACTERISTIC


/begin CHARACTERISTIC KL_TKSM_MR_ABREG
  "Abregung ueber Temperatur Motorraum | EN: Ramp-down over engine-bay temperature"
